# Copy to .env locally and replace placeholders before starting the app.
# Generate a unique JWT key with: openssl rand -hex 32
# Required: uncomment and paste the generated value.
# SECRET_KEY=

# Required: uncomment and provide your PostgreSQL connection string.
# DATABASE_URL=

REDIS_URL=redis://localhost:6379

CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

MP_ACCESS_TOKEN=replace-me
MP_PUBLIC_KEY=replace-me
WEBHOOK_SECRET=replace-me

STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
EMAILS_FROM_EMAIL=noreply@example.com

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
